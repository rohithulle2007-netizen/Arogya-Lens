{
  "expo": {
    "name": "Arogya Lens",
    "slug": "arogya-lens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#042f2e",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arogyalens.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Arogya Lens requires camera access to perform non-invasive optical conjunctival and nail bed scans for hemoglobin screening."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#042f2e"
      },
      "package": "com.arogyalens.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Arogya Lens to access your camera to scan eye conjunctiva and nail bed."
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
