# Arogya Lens - Environment Configuration Example
# Copy this file to .env before starting the server

# Application
APP_NAME="Arogya Lens"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8000

# Security (Replace with a strong random secret in production)
JWT_SECRET_KEY=arogya_lens_dev_secret_key_change_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./arogya_lens.db

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# AI / ML Inference
AI_MOCK_MODE=false

# CORS Allowed Origins (Comma-separated list or *)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:8000,*
