# ==============================================================================
# Arogya Lens — Environment Configuration Template
# For local dev: copy to .env or backend/.env
# For production (Render / Railway): configure in the provider dashboard
# ==============================================================================

# Application Metadata
APP_NAME="Arogya Lens API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Frontend Public API URL (Set as GitHub Actions Repository Variable: VITE_API_BASE_URL)
# Example: https://your-backend.up.railway.app or https://arogya-lens-backend.onrender.com
# VITE_API_BASE_URL=https://your-backend.up.railway.app

# Server Binding
HOST=0.0.0.0
PORT=8000

# Security (CRITICAL: In production, generate a strong random 64-char key)
# e.g. run: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_strong_random_secret_in_production_min32chars
JWT_SECRET_KEY=replace_with_strong_random_secret_in_production_min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# SMS Provider Integration (Optional - Twilio or Fast2SMS)
# If left blank, server defaults to development mock OTP (123456)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=

# Database Persistence
# Local: sqlite:///./arogya_lens.db
# Cloud with Persistent Disk (Render/Railway): sqlite:////app/data/arogya_lens.db
DATABASE_URL=sqlite:///./arogya_lens.db

# Storage Directories
# Local: uploads
# Cloud with Persistent Disk: /app/data/uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# AI / ML Inference Pipeline
AI_MOCK_MODE=false

# CORS Allowed Origins (comma-separated list of permitted origins, or * for public APIs)
ALLOWED_ORIGINS=https://rohithulle2007-netizen.github.io,https://*.github.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:8000,*
